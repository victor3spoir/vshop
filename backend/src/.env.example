# Copy to .env and adjust. All values also work as plain environment
# variables, which take precedence over this file.

# development | production (default: production)
PYTHON_ENV=development

# App metadata
#APP_TITLE=vshop
#APP_DESCRIPTION=Simple ecommerce API
#APP_VERSION=0.1.0

# Database
#DB_HOST=localhost
#DB_PORT=35432
#DB_NAME=postgres
#DB_USER=postgres
#DB_PASSWORD=postgres

# S3 object storage (rustfs locally, any S3-compatible service in prod)
#S3_ENDPOINT_URL=http://localhost:9000
#S3_REGION=us-east-1
#S3_ACCESS_KEY=admin
#S3_SECRET_KEY=admin
#S3_MEDIA_BUCKET=vshop-media
